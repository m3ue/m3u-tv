<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Simulator builds only (CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]):
	     lets the Xcode Simulator's CarPlay window show the app before Apple
	     grants the entitlement. Move it into Runner.entitlements once the
	     App ID has the CarPlay Audio capability; until then a device build
	     with it would fail to sign. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
