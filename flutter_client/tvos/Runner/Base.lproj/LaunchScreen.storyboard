<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder.AppleTV.Storyboard"
          version="3.0" toolsVersion="22505" targetRuntime="AppleTV"
          propertyAccessControl="none" useAutolayout="YES"
          useTraitCollections="YES" useSafeAreas="YES"
          colorMatched="YES" initialViewController="01J-lp-oVM">
  <scenes>
    <scene sceneID="EHf-IW-A2E">
      <objects>
        <viewController id="01J-lp-oVM" sceneMemberID="viewController">
          <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
            <rect key="frame" x="0.0" y="0.0" width="1920" height="1080"/>
            <autoresizingMask key="autoresizingMask"
                              widthSizable="YES" heightSizable="YES"/>
            <subviews>
              <!-- 205pt logo centred on the full screen; LaunchSplash
                   (lib/app/launch_splash.dart) takes over at this exact size
                   and position. -->
              <imageView userInteractionEnabled="NO" contentMode="center"
                         image="LaunchLogo"
                         translatesAutoresizingMaskIntoConstraints="NO"
                         id="LgI-mv-001"/>
            </subviews>
            <!-- #0a0a0f, the app background (scripts/setup-icons.sh APP_BG) -->
            <color key="backgroundColor" red="0.0392156862745098"
                   green="0.0392156862745098" blue="0.058823529411764705"
                   alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints>
              <constraint firstItem="LgI-mv-001" firstAttribute="centerX"
                          secondItem="Ze5-6b-2t3" secondAttribute="centerX"
                          id="LgX-cn-001"/>
              <constraint firstItem="LgI-mv-001" firstAttribute="centerY"
                          secondItem="Ze5-6b-2t3" secondAttribute="centerY"
                          id="LgY-cn-002"/>
            </constraints>
          </view>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder"
                     id="iYj-Kq-Ea1" userLabel="First Responder"
                     sceneMemberID="firstResponder"/>
      </objects>
      <point key="canvasLocation" x="0" y="0"/>
    </scene>
  </scenes>
  <resources>
    <image name="LaunchLogo" width="205" height="205"/>
  </resources>
</document>
